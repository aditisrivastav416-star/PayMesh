PORT=3001
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection used by Prisma (when database support is added)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/paymesh?schema=public

# Dashboard session signing (generate a long random value)
SESSION_SECRET=replace-with-a-long-random-secret

# PayPal Sandbox app credentials; keep these on the backend only
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
PAYPAL_WEBHOOK_ID=replace-with-sandbox-webhook-id

