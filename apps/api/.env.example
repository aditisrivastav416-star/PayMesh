PORT=3001
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection used by Prisma (when database support is added)
DATABASE_URL=postgresql://paymesh:paymesh@127.0.0.1:5433/paymesh?schema=public

# Initial owner account, created by pnpm db:seed (change password before use)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-owner-password

# PayPal Sandbox app credentials; keep these on the backend only
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
PAYPAL_WEBHOOK_ID=replace-with-sandbox-webhook-id

